# Public Mezo testnet endpoint. No private key is needed by this starter.
MEZO_TESTNET_RPC=https://rpc.test.mezo.org
PORT=3000

# For local Foundry deployment commands; use a local signer or wallet CLI.
# Never commit or send private keys or recovery phrases.
ADMIN_ADDRESS=
OPERATOR_ADDRESS=
USE_DEMO_TOKEN=false
PAYMENT_TOKEN_ADDRESS=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503

# Add only after a verified deployment. These are public addresses, never keys.
NEXT_PUBLIC_EPOCH_MARKET_ADDRESS=
NEXT_PUBLIC_EPOCH_CLAIM_ADDRESS=
NEXT_PUBLIC_MOCK_VEBTC_ADDRESS=
NEXT_PUBLIC_MOCK_SOURCE_ADDRESS=
NEXT_PUBLIC_QUOTE_TOKEN_ADDRESS=
NEXT_PUBLIC_ECONOMIC_MODE=OFFICIAL_TESTNET_MUSD
# If using official testnet MEZO instead, set PAYMENT_TOKEN_ADDRESS and
# NEXT_PUBLIC_QUOTE_TOKEN_ADDRESS to 0x7B7c000000000000000000000000000000000001
# and NEXT_PUBLIC_ECONOMIC_MODE=REAL_TESTNET_MEZO.
